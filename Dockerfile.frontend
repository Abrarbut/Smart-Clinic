FROM node:20 AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy lock file
COPY pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
COPY .npmrc ./

# Copy project files
COPY package.json ./
COPY lib ./lib
COPY artifacts/smartclinic ./artifacts/smartclinic
COPY tsconfig.json tsconfig.base.json ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build frontend with required env vars
ENV PORT=3001
ENV BASE_PATH=/
RUN pnpm --filter @workspace/smartclinic run build

# Serve with Nginx
FROM nginx:alpine

COPY --from=builder /app/artifacts/smartclinic/dist /usr/share/nginx/html

# Copy Nginx config
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]