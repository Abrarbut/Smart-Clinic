{
  "name": "smartclinic",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @workspace/api-server",
    "dev:web": "npm run dev -w @workspace/smartclinic",
    "dev": "concurrently -n api,web -c blue,green npm:dev:api npm:dev:web",
    "seed": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs ./scripts/seed.ts",
    "setup": "npm run push -w @workspace/db",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "esbuild": "0.27.3"
  }
}
